# ── Required for all setups ──────────────────────────────────────────────────

# Database credentials
POSTGRES_DB=analytics
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=     # required - generate with: openssl rand -hex 32

# ── Required for SSL setups (Caddy / Traefik / Nginx SSL) ────────────────────

DOMAIN_NAME=           # your domain, e.g. analytics.example.com
SSL_EMAIL=             # your email for Let's Encrypt certificate notifications

# ── Optional tuning ──────────────────────────────────────────────────────────

# API service
API_PORT=3000
API_RATE_LIMIT=100     # max requests per second per IP
API_MAX_LOAD=1000000   # max requests the dashboard will load
API_PAGE_SIZE=250000   # requests fetched per database query

# Logger service
LOGGER_PORT=8000
LOGGER_RATE_LIMIT=10   # max log payloads per second per API key
LOGGER_MAX_INSERT=2000 # max requests accepted in a single payload
