# ── Required for all setups ──────────────────────────────────────────────────

# Database credentials
POSTGRES_DB=analytics
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=     # required - generate with: openssl rand -hex 32

# ── Required for SSL setups (Caddy / Traefik / Nginx SSL) ────────────────────

DOMAIN_NAME=           # your domain, e.g. analytics.example.com
SSL_EMAIL=             # your email for Let's Encrypt certificate notifications

# ── Security & privacy ───────────────────────────────────────────────────────

# Secret pepper mixed into the anonymous per-user hash so that a database dump
# alone cannot be brute-forced back to visitor IP addresses. Read by the logger
# service. setup.sh generates this for you; if you set it by hand, generate it
# ONCE and keep it constant — changing it resets unique-user counts. Leave empty
# to keep the legacy unsalted hash (behaviour is unchanged either way).
USER_HASH_SECRET=      # recommended - generate with: openssl rand -hex 32

# Restrict browser cross-origin (CORS) access to the API and logger to these
# origins, comma-separated, e.g. https://analytics.example.com. Empty allows all
# origins, which is safe here because responses carry no cookies and access is
# gated by an API key or user ID, not by the browser's ambient credentials.
CORS_ALLOWED_ORIGINS=

# ── Optional tuning ──────────────────────────────────────────────────────────

# API service
API_PORT=3000
API_RATE_LIMIT=100     # max requests per second per IP
API_MAX_LOAD=1000000   # max requests the dashboard will load
API_PAGE_SIZE=250000   # requests fetched per database query

# Logger service
LOGGER_PORT=8000
LOGGER_RATE_LIMIT=10    # max log payloads per minute per API key
LOGGER_IP_RATE_LIMIT=100 # max log payloads per minute per source IP
LOGGER_MAX_INSERT=2000  # max requests accepted in a single payload

# Monitor service
MONITOR_INTERVAL=30    # minutes between URL monitor checks

# ── Optional email alerts ────────────────────────────────────────────────────
# The monitor can email you when one of your monitored URLs goes down (or
# recovers). This is OFF unless MONITOR_ALERTS_ENABLED=true, an email provider
# is selected below, and MONITOR_ALERT_EMAIL is set.

MONITOR_ALERTS_ENABLED=false       # set true to enable downtime alerts
MONITOR_ALERT_EMAIL=               # where alerts are sent, e.g. you@example.com

# Email provider: none (default) | smtp | resend | sendgrid | mailgun | ses
EMAIL_PROVIDER=none
EMAIL_FROM_ADDRESS=                # From address for sent mail

# smtp (self-hosted or any SMTP server)
SMTP_SERVER=
SMTP_PORT=587
SMTP_AUTH_TYPE=login               # login | plain | crammd5
EMAIL_USERNAME=
EMAIL_PASSWORD=

# resend
RESEND_API_KEY=

# sendgrid
SENDGRID_API_KEY=

# mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=                  # optional; set to https://api.eu.mailgun.net for EU

# ses (Amazon SES v2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=                        # e.g. eu-west-1
