# Backend server URL for a self-hosted dashboard.
# Set this to your own API Analytics backend before building (`pnpm build`).
# Leave unset to use the default hosted backend (https://www.apianalytics-server.com).
#
# Note: only needed when self-hosting the dashboard itself. If you instead use the
# hosted dashboard at apianalytics.dev, point it at your backend per-visit with the
# ?source= URL param, e.g. https://www.apianalytics.dev/dashboard?source=https://your-domain.com
SERVER_URL=
